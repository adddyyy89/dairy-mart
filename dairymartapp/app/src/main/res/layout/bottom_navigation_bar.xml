<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="5"
    android:background="#FFFFFF"
    android:layout_alignParentBottom="true"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/home_24"  android:contentDescription="Dashboard"
            app:tint="#1A73E8"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DASHBOARD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#1A73E8"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:id="@+id/salesman_dashboard_nav_activity">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_orders"  android:contentDescription="Orders"
            app:tint="#9E9E9E"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORDERS"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#9E9E9E"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:id="@+id/salesman_dashboard_nav_delivery">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/delivered_24"  android:contentDescription="Deliveries"
            app:tint="#9E9E9E"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELIVERIES"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#9E9E9E"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/activity_feed_24"  android:contentDescription="Crates"
            app:tint="#9E9E9E"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRATES"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#9E9E9E"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:id="@+id/salesman_dashboard_nav_ledger">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ledger_24"  android:contentDescription="Ledger"
            app:tint="#9E9E9E"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEDGER"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="#9E9E9E"/>
    </LinearLayout>
</LinearLayout>
